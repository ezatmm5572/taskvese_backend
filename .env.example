# ==============================================================
# Vercel Environment Variables Checklist
# Add these in: Vercel Dashboard > Project Settings > Environment Variables
# ==============================================================

# MongoDB Connection String (Atlas URI)
DB_URI="mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/taskManagementSystem?retryWrites=true&w=majority"

# Node Environment & Port
NODE_ENV="production"
PORT=3000

# Upstash Redis (Serverless REST API)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# Security & Secrets
JWT_SECRET="your_secure_jwt_secret_here"
HASH_SALT=12
ENCRYPTION_KEY_ENV="727a1aa452c4759593da5cd2704dc3d596e201db1950e5309be427e2b5e53251"

# Email Notifications (Nodemailer Gmail SMTP)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Cloudinary (File/Image Uploads)
CLOUD_NAME="your-cloud-name"
API_KEY_CLOUDENARY="your-api-key"
API_SECRET_CLOUDENARY="your-api-secret"

# Public URL of the deployed FRONTEND (used in member invitation emails)
APP_URL="https://your-frontend.vercel.app"

# Allowed browser origin(s) for CORS, comma separated (your frontend URL)
CORS_ORIGIN="https://your-frontend.vercel.app"
