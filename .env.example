# ==============================================================
# TaskVerse Backend - Environment Variables Specification
# ==============================================================

# MongoDB Connection String (Atlas URI or local)
DB_URI="mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/taskManagementSystem?retryWrites=true&w=majority"

# Node Environment & Port
NODE_ENV="production"
PORT=3000

# Upstash Redis (Serverless REST API)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# JWT & Password Encryption
JWT_SECRET="your_very_long_secure_jwt_secret_key_here"
HASH_SALT=12
ENCRYPTION_KEY_ENV="727a1aa452c4759593da5cd2704dc3d596e201db1950e5309be427e2b5e53251"

# Email Notifications (Mailjet HTTPS API)
# Sender must be validated and active in your Mailjet account.
MAILJET_API_KEY="your_mailjet_public_api_key"
MAILJET_SECRET_KEY="your_mailjet_private_secret_key"
MAILJET_FROM_EMAIL="your-verified-sender@example.com"
MAILJET_FROM_NAME="TaskVerse"

# Cloudinary (File & Attachment Uploads)
CLOUD_NAME="your-cloudinary-cloud-name"
API_KEY_CLOUDENARY="your-cloudinary-api-key"
API_SECRET_CLOUDENARY="your-cloudinary-api-secret"

# Frontend Application URL (used in email invitation links)
FRONTEND_URL="https://taskverse-frontend-ochre.vercel.app"
APP_URL="https://taskverse-frontend-ochre.vercel.app"

# CORS Origins (Explicit comma-separated list, NO wildcard '*' with credentials)
CORS_ORIGINS="https://taskverse-frontend-ochre.vercel.app,http://localhost:5173,http://localhost:5180"

# Web Push (VAPID)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_MAILTO="mailto:admin@taskverse.com"

# Cron Secret (for securing cron webhook endpoints)
CRON_SECRET="your-secure-cron-trigger-secret"
